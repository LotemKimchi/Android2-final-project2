PORT=3000
# Atlas connection string; <db_username>/<db_password> are filled from the two variables below
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/
MONGO_USERNAME=
MONGO_PASSWORD=
# Database name (default: circles)
# MONGO_DB_NAME=circles
# Set to at least 32 random characters (startup fails until you do)
JWT_SECRET=change-me
UPLOAD_DIR=uploads
