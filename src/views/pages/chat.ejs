<%- include('../partials/head', { title, styles: ['/css/chat.css'] }) %>
<h1>Chat</h1>
<div class="chat">
  <aside class="card chat__sidebar">
    <h2>Friends</h2>
    <ul id="chat-friends" class="chat__friends"></ul>
  </aside>
  <section class="card chat__conversation">
    <header id="chat-header" class="chat__header muted">Choose a friend to start chatting</header>
    <button id="chat-load-older" class="btn btn--ghost hidden" type="button">Load older messages</button>
    <ol id="chat-messages" class="chat__messages" aria-live="polite"></ol>
    <form id="chat-form" class="chat__form hidden" novalidate>
      <div class="field">
        <input name="text" maxlength="1000" autocomplete="off" placeholder="Type a message…" aria-label="Message">
        <small class="field-error" data-error-for="text"></small>
      </div>
      <button class="btn btn--primary" type="submit">Send</button>
    </form>
  </section>
</div>
<%- include('../partials/foot', { scripts: ['/js/pages/chat.js'], useSocket: true }) %>
